import matplotlib.pyplot as plt
import pandas as pd
df=pd.read_csv("Earth_quakes 1990-2023.csv")
df['date'] = pd.to_datetime(df['date'],errors='coerce')
df['year'] = df['date'].dt.year
earthquake_per_year = df['year'].value_counts().sort_index()

plt.figure(figsize=(12, 6))
earthquake_per_year.plot(kind='line')
plt.title('Number of Earthquakes Per Year (1990-2023)')
plt.xlabel('Year')
plt.ylabel('Number of Earthquakes')
plt.grid(True)
plt.show()

plt.scatter(df['magnitudo'],df['depth'])
plt.title('magnituo vs depth')
plt.xlabel('magnitudo')
plt.ylabel('depth')
plt.grid(True)
plt.show()

plt.scatter(df['longitude'],df['latitude'])
plt.title('longitude vs latitude')
plt.xlabel('longitude')
plt.ylabel('latitude')
plt.grid(True)
plt.show()

california_df = df[df['state'].str.contains("California", case=False, na=False)]
correlation_matrix = california_df[['magnitudo', 'depth', 'significance', 'tsunami']].corr()
correlation_matrix

california_df = df[df['state'].str.contains("California", case=False, na=False)]

# Calculate the correlation between magnitude and depth
magnitude_depth_corr = california_df['magnitudo'].corr(california_df['depth'])

# Create a scatter plot with a regression line
plt.figure(figsize=(10, 6))
plt.scatter(x='depth', y='magnitudo', data=california_df)
plt.title(f'Scatter Plot of Magnitude vs. Depth in California\nCorrelation: {magnitude_depth_corr:.2f}')
plt.xlabel('Depth (km)')
plt.ylabel('Magnitudo')
plt.grid(True)
plt.show()

plt.figure(figsize=(10,6))
plt.scatter(x='significance', y='tsunami', data=california_df, alpha=0.6)
plt.title('Scatter Plot of Significance vs. Tsunami in California')
plt.xlabel('Significance')
plt.ylabel('Tsunami (0 = No, 1 = Yes)')
plt.grid(True)
plt.show()

